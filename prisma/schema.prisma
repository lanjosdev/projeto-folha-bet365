generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Machine {
  id        String   @id
  createdAt DateTime @default(now()) @map("created_at")

  @@map("machines")
}

model User {
  id        String   @id @default(uuid()) @db.Char(36)
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("users")
}
